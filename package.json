{
  "name": "ayla",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:production-login": "node scripts/Check-AylaProductionLogin.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:extension": "node scripts/Check-AylaCookieManager.mjs",
    "test:extension": "npm test --prefix extensions/ayla-cookie-manager",
    "test:api": "node --test server/test/*.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && npm run check:production-login && npm run check:extension && npm run test:extension && npm run test:api && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
