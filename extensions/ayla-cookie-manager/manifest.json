{
  "manifest_version": 3,
  "name": "Ayla Cookies for Microsoft Edge",
  "short_name": "Ayla Edge Cookies",
  "version": "0.2.0",
  "description": "Importe cookies.txt, gerencie e apague cookies do Microsoft Edge localmente com a interface do Ayla.",
  "minimum_chrome_version": "130",
  "permissions": [
    "browsingData",
    "contextMenus",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ayla Cookies for Microsoft Edge",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "open-manager": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Abrir o Ayla Cookies para Microsoft Edge"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "split"
}
