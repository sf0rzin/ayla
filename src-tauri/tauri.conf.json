{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ayla",
  "version": "0.3.2",
  "identifier": "com.ayla.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ayla",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://ayla.rindexx.cc"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMUE3ODFFMUZEMjM1RDcKUldUWE5kSWZIbmdhTzRNYUFkbjdYRUg0c0txSm5HSlRrU3MrMkloTGVhck9EL25pSXZxT09JSTMK",
      "endpoints": [
        "https://ayla.rindexx.cc/updates/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
