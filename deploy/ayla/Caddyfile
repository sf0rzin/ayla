{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

ayla.rindexx.cc {
	encode zstd gzip
	root * /srv/ayla-public

	@latest path /updates/stable/latest.json
	header @latest Cache-Control "no-store, max-age=0"

	@release path /updates/releases/*
	header @release Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			# The guest firewall only admits public web traffic from Cloudflare.
			# Replace any visitor-supplied XFF chain with Cloudflare's canonical IP.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	@latest_available {
		path /updates/stable/latest.json
		file
	}
	handle @latest_available {
		file_server
	}

	handle /updates/stable/latest.json {
		respond 204
	}

	handle /updates/* {
		file_server
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		respond "Ayla service" 200
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log
}
